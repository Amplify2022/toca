# TOCÁ development — create .env and set a strong random password.
DB_USERNAME=toca
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Spotify is optional. Leave empty to try demo / API without Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/integrations/spotify/callback
# Must be 32 random bytes, Base64-encoded. Run: openssl rand -base64 32
SPOTIFY_TOKEN_ENCRYPTION_KEY_BASE64=
# OFF: use only in authorized PRIVATE LAB tests when explicitly needed.
SPOTIFY_PRIVATE_TEST_CONTROL=false
# Default OFF, respected by Docker Compose. Enable only for private, permitted
# experimentation: this edits the real Spotify playlist independently of player control.
SPOTIFY_PRIVATE_TEST_PLAYLIST_WRITES=false

# Separate password for restricted PostgreSQL role toca_app (required by Compose).
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
# Public deployment only: DNS must point here, ports 80/443 reachable.
# TOCA_DOMAIN=toca.example.com
# FRONTEND_ORIGIN=https://toca.example.com
# SMTP recovery/verification requires TLS and a public HTTPS frontend origin.
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_SMTP_FROM=

# Required only for public gateway: generate at least 32 random characters.
TRUSTED_PROXY_TOKEN=
